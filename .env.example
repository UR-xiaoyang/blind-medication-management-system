# ============================
# 盲人智能用药管理系统 - 环境变量
# ============================
# 复制为 .env 并按需修改：

# 域名（用于 Caddy 自动申请 Let's Encrypt 证书）
# 留空或注释则使用自签名证书（本地测试用）
APP_DOMAIN=medbox.example.com

# Create a strong value with: openssl rand -hex 32
JWT_SECRET=<set-a-long-random-secret>

# 数据库数据目录挂载点（宿主机路径，Docker volume 或 bind mount）
# BACKEND_DATA=./data
