# Caddyfile — 自动 HTTPS 反向代理
# 不设 CADDY_DOMAIN 时使用 internal TLS（自签名），浏览器会提示不安全但可用。
# 设置 CADDY_DOMAIN 后自动申请 Let's Encrypt 证书。

{$CADDY_DOMAIN:localhost} {
    # 后端 API
    reverse_proxy /api/* backend:8080

    # WebSocket（/api/ws 已被上条匹配，此条兼容旧路由）
    reverse_proxy /api/ws backend:8080

    # 前端静态资源
    reverse_proxy frontend:80
}
